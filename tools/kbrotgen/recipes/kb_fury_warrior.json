            "stance": [
              "Battle Stance"
            ],
            "mob_distance_min": 8,
            "mob_distance_max": 25,
            "tank_holds": true
          }
        },
        {
          "id": "sunder_armor",
          "spell": "Sunder Armor",
          "level": 10,
          "target": "fight",
          "when": {
