  "mode": "",
  "notes": "The Turtle knowledge base's frost raid list: Icicles only on a Flash Freeze proc, Ice Barrier on cooldown for its damage buff, Frost Nova and Cone of Cold on a boss in melee range, Cold Snap after a Nova, Frostbolt as the filler, and the AoE loop (Cone of Cold, Frost Nova, Arcane Explosion, rank-1 Blizzard). The KB's opener order, the freeze immunity of a raid boss and the pack sizes are not conditions (kb.unexpressed).",
  "rows": [
    {
      "from": "rotation_single",
      "index": 0,
      "priority": 0,
      "text": "Pre-pull Ice Barrier; opener Frostbolt -> Icicles -> Frost Nova -> Icicles (or Frostbolt -> Cone of Cold -> Icicles -> Frost Nova -> Icicles) | freeze-immune boss",
      "text_sha": "d3fc1327f60e",
      "entries": [],
      "unexpressed": "pre-pull/opener outside the brain's fight"
    },
    {
      "from": "rotation_single",
      "index": 1,
      "priority": 1,
      "text": "Icicles | Flash Freeze active ONLY (never raw)",
      "text_sha": "8305f7d6813e",
      "entries": [
        {
          "id": "icicles",
          "spell": "Icicles",
          "talent": true,
          "target": "fight",
          "when": {
            "moving": false,
            "self_aura": [
              "Flash Freeze"
            ]
          }
        }
      ]
    },
    {
      "from": "rotation_single",
      "index": 2,
      "priority": 2,
      "text": "Ice Barrier | off cooldown (+10% Frost damage for 60 s on cast)",
      "text_sha": "3aa9e36d8cbe",
      "entries": [
        {
          "id": "ice_barrier",
          "spell": "Ice Barrier",
          "talent": true,
          "target": "self",
          "when": {
            "no_self_aura": [
              "Ice Barrier"
            ]
          }
        }
      ]
    },
    {
      "from": "rotation_single",
      "index": 3,
      "priority": 3,
      "text": "Frost Nova | off cooldown AND in melee range of a freeze-immune boss",
      "text_sha": "72afde748592",
      "entries": [
        {
          "id": "frost_nova",
          "spell": "Frost Nova",
          "level": 10,
          "target": "self",
          "threat": "aoe",
          "harmful": true,
          "when": {
            "mob_distance_max": 10
          },
          "note": "mob_distance_max 10 is Frost Nova's radius; the KB's \"freeze-immune\" is not a condition."
        }
      ],
      "unexpressed": "a freeze-immune target is not a condition"
    },
    {
      "from": "rotation_single",
      "index": 4,
      "priority": 4,
      "text": "Cone of Cold | in range (Frostbite can proc Flash Freeze)",
      "text_sha": "b16bc82dc4b1",
      "entries": [
        {
          "id": "cone_of_cold",
          "spell": "Cone of Cold",
          "level": 26,
          "target": "self",
          "threat": "aoe",
          "harmful": true,
          "when": {
            "mob_distance_max": 10
          }
        }
      ]
    },
    {
      "from": "rotation_single",
      "index": 5,
      "priority": 5,
      "text": "Cold Snap | Nova on cooldown and a burst window is wanted",
      "text_sha": "13e072620b36",
      "entries": [
        {
          "id": "cold_snap",
          "spell": "Cold Snap",
          "talent": true,
          "target": "self",
          "band": "high",
          "when": {
            "state": "combat",
            "mob_aura": [
              "Frost Nova"
            ]
          },
          "note": "mob_aura Frost Nova stands in for \"Nova on cooldown\": the debuff means a Nova just landed."
        }
      ]
    },
    {
      "from": "rotation_single",
      "index": 6,
      "priority": 6,
      "text": "Frostbolt | default; macro /cast [mybuff:Flash_Freeze] Icicles; Frostbolt",
      "text_sha": "999f143d60c3",
