        {
          "id": "frostbolt",
          "spell": "Frostbolt",
          "level": 4,
          "target": "fight",
          "when": {
            "moving": false
          },
          "note": "Moved after the AoE entries: the filler has no cooldown, so as a rule it would starve every entry the KB lists after it."
        }
      ],
      "unexpressed": "macro/addon (Nampower etc.)"
    },
