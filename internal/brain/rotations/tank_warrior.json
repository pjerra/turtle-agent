{
 "version": 1,
 "name": "tank_warrior",
 "class": "warrior",
 "spec": "protection",
 "replaces": [
  "warrior_melee",
  "warrior_tank"
 ],
 "notes": "The data twin of warrior_melee + warrior_tank in Defensive Stance: Sunder Armor to five stacks, Revenge after an avoided attack, Shield Block when hurt with a mob on the tank, Thunder Clap and Demoralizing Shout with two or more mobs, Heroic Strike and Cleave to dump rage. The taunt and the choice of mob are role_tank's.",
 "sources": [
  "mod-playerbots 79bd428 src/Ai/Class/Warrior/Strategy/GenericWarriorStrategy.cpp (rage dump, Battle Shout, Bloodrage, Execute, Hamstring)",
  "mod-playerbots 79bd428 src/Ai/Class/Warrior/Strategy/TankWarriorStrategy.cpp"
 ],
